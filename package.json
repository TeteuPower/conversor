{
  "name": "conversor",
  "version": "0.1.0",
  "private": true,
  "description": "Conversor de arquivos que roda na sua máquina. Nada sai daqui.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "nucleo",
    "servidor",
    "web"
  ],
  "scripts": {
    "dev": "node ferramentas/dev.mjs",
    "build": "npm run build --workspace=nucleo && npm run build --workspace=web && npm run build --workspace=servidor",
    "start": "npm run start --workspace=servidor",
    "teste": "npm run teste --workspaces --if-present",
    "tipos": "tsc --build --verbose",
    "vetorizador": "cd vetorizador/fonte && python montar.py . ../vetorizador.html",
    "e2e": "node e2e/fluxo.mjs",
    "e2e:comprimir": "node e2e/comprimir.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.6.3"
  }
}
